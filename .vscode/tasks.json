{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Flutter pub get",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Flutter analyze",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Flutter test",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Backend: npm install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: npm run lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: npm test",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}